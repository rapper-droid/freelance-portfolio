{
  "name": "freelance-portfolio",
  "version": "1.0.0",
  "description": "Web開発・業務自動化の実働ポートフォリオ",
  "scripts": {
    "check:workers": "vinext check",
    "build:workers": "node scripts/workers-preview.mjs build",
    "preview:workers": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 3170",
    "deploy:workers:preview": "node scripts/workers-preview.mjs deploy",
    "types:workers": "wrangler types worker-configuration.d.ts",
    "typecheck:workers": "tsc --project tsconfig.workers.json",
    "qa:state:native": "node scripts/native-state-qa.mjs",
    "qa:contact:native": "node scripts/native-contact-qa.mjs",
    "qa:hosting": "node scripts/hosting-performance.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "screenshots": "node --experimental-strip-types scripts/portfolio-screenshots.mjs",
    "qa:visual": "node --experimental-strip-types scripts/visual-qa.mjs",
    "verify:all": "npm run verify && npm run format:check && npm run test:e2e && npm run screenshots && npm run qa:visual && npm run qa:links",
    "qa:performance": "node scripts/performance.mjs",
    "build:production": "node scripts/check-production.mjs && next build",
    "qa:links": "node --experimental-strip-types scripts/link-qa.mjs",
    "qa:design": "node scripts/sales-design-qa.mjs",
    "qa:seo": "node --experimental-strip-types scripts/seo-regression.mjs",
    "growth:lint": "node --experimental-strip-types scripts/growth-lint.mjs",
    "growth:brief": "node --experimental-strip-types scripts/growth-brief.mjs",
    "qa:flow": "node scripts/flow-qa.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/browser": "^10.74.0",
    "@sentry/node": "^10.74.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsonc-parser": "3.3.1",
    "lighthouse": "^13.4.1",
    "miniflare": "5.20260916.0-alpha",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "4.133.0"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
