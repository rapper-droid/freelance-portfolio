{
  "name": "freelance-portfolio",
  "version": "1.0.0",
  "description": "Web開発・業務自動化の実働ポートフォリオ",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "screenshots": "node --experimental-strip-types scripts/portfolio-screenshots.mjs",
    "qa:visual": "node --experimental-strip-types scripts/visual-qa.mjs",
    "verify:all": "npm run verify && npm run format:check && npm run test:e2e && npm run screenshots && npm run qa:visual && npm run qa:links",
    "qa:performance": "node scripts/performance.mjs",
    "build:production": "node scripts/check-production.mjs && next build",
    "qa:links": "node --experimental-strip-types scripts/link-qa.mjs",
    "qa:design": "node scripts/sales-design-qa.mjs",
    "qa:seo": "node --experimental-strip-types scripts/seo-regression.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/browser": "^10.74.0",
    "@sentry/node": "^10.74.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
