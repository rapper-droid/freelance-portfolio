{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsudowa-production",
  "account_id": "403d3196e2006bbfb76edb1eba214acf",
  "main": "src/workers/production-entry.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [],
  "durable_objects": {
    "bindings": [{ "name": "CONTACT_STATE", "class_name": "ContactState" }],
  },
  "migrations": [
    { "tag": "contact-state-v1", "new_sqlite_classes": ["ContactState"] },
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://tsudowa.com",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAE6gUHBs1hey6e76",
    "CONTACT_ENABLED": "true",
    "NEXT_PUBLIC_ANALYTICS_ENABLED": "true",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "CONTACT_FROM_EMAIL": "no-reply@tsudowa.com",
    "CONTACT_TO_EMAIL": "contact@tsudowa.com",
    "HOSTING_PLATFORM": "cloudflare",
    "STATE_BACKEND": "durable-objects",
    "OWNER_REVIEW": "false",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
    },
  },
}
