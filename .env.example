# Public HTTPS origin, no path/query/fragment. Required by build:production.
NEXT_PUBLIC_SITE_URL=
# Contact remains unavailable until all private settings are present.
CONTACT_ENABLED=false
# Public widget identifier (safe to expose); production hostname must be registered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only. Never prefix these with NEXT_PUBLIC_.
TURNSTILE_SECRET=
RESEND_API_KEY=
# Use a verified sender domain; owner-only onboarding sender is suitable for initial receipt testing.
CONTACT_FROM=
CONTACT_TO=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters. Never publish or reuse an existing password.
RATE_LIMIT_SALT=
# Optional allowlisted, short-lived anonymous funnel. No replay/autocapture.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Public browser ingestion DSN; server DSN is separate for clear ownership.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
