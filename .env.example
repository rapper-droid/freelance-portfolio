# Public HTTPS origin. No path, credentials, query or fragment. Blank = local preview.
NEXT_PUBLIC_SITE_URL=
# Optional anonymous allowlisted analytics; no SDK autocapture or session replay.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Optional browser error monitoring. DSN is a public ingestion identifier.
NEXT_PUBLIC_SENTRY_DSN=
